---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Olubanj Global Services</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alata&family=Spartan:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">Olubanj <span>Global</span></a>
      <nav>
        {nav.map(item => (
          <a href={item.href} class={path === item.href ? "active" : ""}>{item.label}</a>
        ))}
        <a href="/contact" class="btn">Get Started</a>
      </nav>
    </div>
  </header>
  
  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p><strong>Olubanj Global Services</strong></p>
      <p>Plot 32, Admiral Ayinla Way, Ikate Lekki, Lagos</p>
      <p>08060482188 · banjiolu@gmail.com</p>
      <p class="copy">© {new Date().getFullYear()} Olubanj Global Services. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); border-bottom: 1px solid #eef2f1; }
  .header-inner { display: flex; justify-content: space-between; align-items: center; padding-block: 1rem; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .brand span { color: var(--brand); }
  nav { display: flex; gap: 1.5rem; align-items: center; }
  nav a { color: var(--ink); font-size: .95rem; text-decoration: none; }
  nav a.active { color: var(--brand); font-weight: 600; }
  .site-footer { background: var(--brand-soft); padding: 3rem 0 2rem; color: var(--ink); }
  .site-footer .copy { margin-top: 1.5rem; font-size: .85rem; color: var(--muted); }
  @media (max-width: 720px) { nav { gap: .75rem; } nav a:not(.btn) { display: none; } }
</style>